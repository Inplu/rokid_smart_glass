<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.rokid.glass.GlassOfflineRecFaceTrackActivity">

    <Button
        android:id="@+id/bt_start_track"
        android:text="@string/demo_start_detection"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bt_stop_track"
        app:layout_constraintHorizontal_weight="1"
        android:textAllCaps="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/bt_add_track"
        android:text="@string/demo_add_recognition_model_file"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bt_stop_track"
        app:layout_constraintHorizontal_weight="1"
        android:textAllCaps="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <Button
        android:id="@+id/bt_stop_track"
        android:text="@string/demo_stop_detection"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bt_start_track"
        app:layout_constraintEnd_toStartOf="@id/bt_add_track"
        app:layout_constraintHorizontal_weight="1"
        android:textAllCaps="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>
