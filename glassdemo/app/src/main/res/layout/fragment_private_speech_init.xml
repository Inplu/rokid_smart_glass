<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <Button
            android:id="@+id/btn_private_init"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:singleLine="false"
            android:ellipsize="none"
            android:background="@drawable/speech_button_background"
            android:backgroundTint="@null"
            android:text="@string/demo_initialize_sdk"
            android:textAllCaps="false"
            android:textColor="@color/speech_button_text" />

        <Button
            android:id="@+id/btn_private_release"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:singleLine="false"
            android:ellipsize="none"
            android:layout_marginTop="6dp"
            android:background="@drawable/speech_button_background"
            android:backgroundTint="@null"
            android:text="@string/demo_close_sdk_and_unbind"
            android:textAllCaps="false"
            android:textColor="@color/speech_button_text" />

    </LinearLayout>
</ScrollView>
