<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ScrollView
        android:id="@+id/controlsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/scrollView"
        app:layout_constraintVertical_weight="3">
        <com.rokid.glass.view.UniformButtonRowsLayout
            android:id="@+id/llMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:orientation="vertical"
            android:paddingBottom="6dp"
            tools:context="com.rokid.glass.SendMessageActivity">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnOnlineTts"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_select_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_online_tts_2"
                    android:textColor="@color/green"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnOfflineTts"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_offline_tts"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnOnlineAsr"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_online_asr_2"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/wfSendTextBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_send_p2p_text"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/wfSendFileBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_send_p2p_file"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btSendTextBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_send_bluetooth_text"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btSendFileBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_send_bluetooth_file"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btSendAudioStream"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_send_audio_stream"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btStopSendAudioStream"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_stop_sending_audio"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btCameraShare"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_share_camera"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:baselineAligned="false"
                android:orientation="horizontal">


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btQRCodeImage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_read_qr_code_image"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btQRCode"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_scan_qr_code"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btQRCodeXml"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"

                    android:paddingVertical="4dp"
                    android:text="@string/demo_scan_qr_code_xml"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btConnectWifi"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_connect_wi_fi_2"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btDisconnectWifi"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_disconnect_wi_fi_2"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btConfigureAppVisibility"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:layout_height="match_parent"
                    android:minHeight="40dp"
                    android:minLines="2"
                    android:background="@drawable/round_unselect_bg"
                    android:gravity="center"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="4dp"
                    android:text="@string/demo_app_display_settings"
                    android:textColor="@color/green_normal_40"
                    android:textSize="12sp"
                    android:ellipsize="none"
                    android:singleLine="false" />


            </LinearLayout>

        </com.rokid.glass.view.UniformButtonRowsLayout>

    </ScrollView>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_min="64dp"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/controlsScrollView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/green_normal_60"
                android:textSize="11sp" />

        </LinearLayout>

    </ScrollView>

    <View
        android:id="@+id/keyMark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
