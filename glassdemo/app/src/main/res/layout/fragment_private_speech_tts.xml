<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_private_tts_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:singleLine="false"
            android:ellipsize="none"
            android:background="@drawable/speech_button_background"
            android:backgroundTint="@null"
            android:text="@string/demo_connect_connect"
            android:textAllCaps="false"
            android:textColor="@color/speech_button_text" />

        <Button
            android:id="@+id/btn_private_tts_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:singleLine="false"
            android:ellipsize="none"
            android:layout_marginTop="4dp"
            android:background="@drawable/speech_button_background"
            android:backgroundTint="@null"
            android:text="@string/demo_speak_sample_text"
            android:textAllCaps="false"
            android:textColor="@color/speech_button_text" />

        <Button
            android:id="@+id/btn_private_tts_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:singleLine="false"
            android:ellipsize="none"
            android:layout_marginTop="4dp"
            android:background="@drawable/speech_button_background"
            android:backgroundTint="@null"
            android:text="@string/demo_stop_playback"
            android:textAllCaps="false"
            android:textColor="@color/speech_button_text" />

        <Button
            android:id="@+id/btn_private_tts_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:singleLine="false"
            android:ellipsize="none"
            android:layout_marginTop="4dp"
            android:background="@drawable/speech_button_background"
            android:backgroundTint="@null"
            android:text="@string/demo_close_close"
            android:textAllCaps="false"
            android:textColor="@color/speech_button_text" />

    </LinearLayout>
</ScrollView>
