<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bottom_dialog_bg">

    <!-- 标题 -->
    <!-- Title. -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0c120d"
        android:gravity="center"
        android:text="@string/demo_enter_information"/>

    <TextView
        android:id="@+id/tv_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:paddingTop="16dp"
        android:textColor="#666666"
        android:gravity="center"
        android:hint="@string/demo_enter_content"/>

    <!-- 按钮区域 -->
    <!-- Button area. -->
    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:minHeight="48dp"
        android:layout_marginTop="24dp"
        android:text="@string/demo_ok"
        android:textSize="16sp"
        android:minWidth="100dp"
        android:background="@drawable/rounded_corner_black_bg"
        android:textColor="@android:color/white"/>


</LinearLayout>
